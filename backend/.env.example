OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=ai_career_refresh
# Production HTTPS deployments should set this to true.
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# Streaming message persistence (flush when either threshold is reached)
CHAT_STREAM_PERSIST_INTERVAL_SECONDS=0.75
CHAT_STREAM_PERSIST_CHARS=256

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_career.db

# Optional: ffmpeg binary path (Windows)
FFMPEG_BIN=

# STT (speech-to-text)
STT_MODEL=whisper-1
STT_TRANSCRIBE_PATH=/audio/transcriptions
STT_TRANSCRIBE_URL=
STT_TIMEOUT_SECONDS=120

# TTS (text-to-speech)
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_SPEECH_PATH=/audio/speech
TTS_SPEECH_URL=
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=120
