OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=15
REFRESH_EXPIRE_DAYS=7
# Set true for HTTPS production. Keep false only for local HTTP development.
REFRESH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_career.db

# Optional: ffmpeg binary path (Windows)
FFMPEG_BIN=

# STT (speech-to-text)
STT_MODEL=whisper-1
STT_TRANSCRIBE_PATH=/audio/transcriptions
STT_TRANSCRIBE_URL=
STT_TIMEOUT_SECONDS=120

# TTS (text-to-speech)
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_SPEECH_PATH=/audio/speech
TTS_SPEECH_URL=
TTS_RESPONSE_FORMAT=mp3
TTS_TIMEOUT_SECONDS=120
# Maximum unexpired login sessions per account; never evicts active sessions.
AUTH_MAX_ACTIVE_SESSIONS_PER_USER=20

# JD task admission: keep disabled until Worker integration is complete.
CHAT_RUNS_ENABLED=false
CHAT_RUNS_PER_USER=3
CHAT_RUNS_CAPACITY=100

# Independent JD Worker / Redis (enable only after migration and service setup)
REDIS_URL=redis://127.0.0.1:6379/0
RUN_ENVIRONMENT=development
RUN_WORKER_CONCURRENCY=2
RUN_SNAPSHOT_SECONDS=2
RUN_LEASE_SECONDS=60
RUN_QUEUE_TIMEOUT=300
RUN_TIMEOUT=600
RUN_TEXT_LIMIT=100000
RUN_EVENT_LIMIT=2000
RUN_EVENT_TTL=86400
